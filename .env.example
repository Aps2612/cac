# Copy to .env and adjust as needed. All values have sane defaults in app/config.py.

# --- Database ---
DATABASE_URL=postgresql://cac:cac@localhost:55432/cac

# --- LLM ---
# Provider: "mock" (default, deterministic, no API key, runs offline) | "anthropic" | "openai"
LLM_PROVIDER=mock
# Used only when LLM_PROVIDER=anthropic. If empty, the app falls back to the mock provider.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
# Used only when LLM_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Cost guardrails (per pipeline run) ---
LLM_MAX_CALLS_PER_RUN=200
LLM_MAX_USD_PER_RUN=5.0

# --- Governance ---
# Fraction of each cohort held out as control (never sent), used to measure true lift.
CONTROL_HOLDOUT_PCT=0.15
# Frequency cap: at most N sends per customer within the rolling window.
FREQUENCY_CAP_PER_WINDOW=1
FREQUENCY_WINDOW_DAYS=3

# --- Personalization ---
# How many per-customer message bodies to generate with the real LLM (cost-bounded).
# 0 = use deterministic templated copy driven by the cohort strategy (recommended for the demo).
PERSONALIZE_LLM_SAMPLE=0

# --- Synthetic data ---
SYNTHETIC_CUSTOMERS=5000
SYNTHETIC_SEED=7
